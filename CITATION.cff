    family-names: Huber
    email: florian.huber1@wu.ac.at
    affiliation: "Vienna University of Economics and Business (WU)"
    orcid: "https://orcid.org/0009-0000-4927-3104"
license: MIT
version: "0.1.0"
date-released: "2026-11-26"
repository-code: "https://github.com/florihu/pySUTO"
keywords:
  - material flow analysis
  - supply-use tables
  - data reconciliation
  - uncertainty
  - copper
